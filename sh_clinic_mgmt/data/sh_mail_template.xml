<odoo>
    <record id="mail_template_cancel_appointment" model="mail.template">
        <field name="name">Appointment Cancellation Email</field>
        <field name="subject">Appointment Cancelled - ${object.name}</field>
        <field name="email_from"></field>
        <field name="email_to">{{object.partner_id.sh_email}}</field>
        <field name="model_id" ref="sh_clinic_mgmt.model_sh_appointment" />
        <field name="body_html">
        <![CDATA[
                <p>Dear ${object.sh_patient_id.name},</p>
                <p>Your appointment <strong>${object.name}</strong> scheduled on
                <strong>${object.sh_slt_id.sh_start_time}</strong> has been cancelled.</p>
                <p>If you have any questions, please contact us.</p>
                <p>Thank you.</p>
                ]]>
        </field>
    </record>
</odoo>