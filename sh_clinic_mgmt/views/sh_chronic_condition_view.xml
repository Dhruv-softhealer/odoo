<odoo>
    <record id="sh_chronic_condition_list_view" model="ir.ui.view">
        <field name="name">Chronic Condition</field>
        <field name="model">sh.chronic.condition</field>
        <field name="arch" type="xml">
            <list string="Chronic Condition">
                <field name="name"></field>
            </list>
        </field>
    </record>

    <record id="sh_chronic_condition_form_view" model="ir.ui.view">
        <field name="name">Chronic Condition</field>
        <field name="model">sh.chronic.condition</field>
        <field name="arch" type="xml">
            <form string="Chronic Condition">
                <sheet>
                    <group>
                        <field name="name"></field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sh_chronic_condition_search_view" model="ir.ui.view">
        <field name="name">Search Chronic</field>
        <field name="model">sh.chronic.condition</field>
        <field name="arch" type="xml">
            <search string="Chronic Search">
                <field name="name"></field>
                <!-- <group expand="0" string="Group BY">
                    <filter name="chronic_name" string="Chronic Name" context="{'group_by' : 'name'}"></filter>
                </group> -->
            </search>
        </field>
    </record>

    <record id="sh_chronic_condition_action_view" model="ir.actions.act_window">
        <field name="name">Chronic Condition</field>
        <field name="res_model">sh.chronic.condition</field>
        <field name="view_mode">list,form,search</field>
    </record>
</odoo>