<odoo>
    <record id="sh_hr_employee_view" model="ir.ui.view">
        <field name="name">Employee View</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">

            <xpath expr="//field[@name='job_id']" position="before">
                <field name="sh_old_case_charges"></field>
                <field name="sh_new_case_charges"></field>
            </xpath>

            <xpath expr="//field[@name='category_ids']" position="after">
                <field name="sh_specialization"></field>
            </xpath>

            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="hr_access" string="Access &amp; Permission">
                    <group>
                        <field name="sh_user_login_access" />
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">Doctor Name</attribute>
            </xpath>
        </field>
    </record>
    <record id="sh_doctor_action_view" model="ir.actions.act_window">
        <field name="name">Doctor</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>