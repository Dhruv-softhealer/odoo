<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_partner_form" model="ir.ui.view">
        <field name="name">inherit.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-ticket" name="nav_related_ticket"  type="object">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Tickets</span>
                        <field name="sh_ticket_count" class="o_stat_value"/>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>