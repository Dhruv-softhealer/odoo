<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View Mass Action form -->
    <record id="view_mass_action_form" model="ir.ui.view">
        <field name="name">view.Mass.Action.form</field>
        <field name="model">mass.action</field>
        <field name="arch" type="xml">
            <form string="Mass Action">
                <group>
                <field name="stage" />
                </group>
                <footer>
                   <button string='Update'  name='close_stage_method'  type='object' class="btn btn-success"/>
                   <button string='Discard' special='cancel' class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action Mass Action -->
    <record id="action_mass_action" model="ir.actions.act_window">
        <field name="name">Mass Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">mass.action</field>
        <field name="view_mode">form</field>
         <field name="target">new</field>
    </record>

</odoo>
