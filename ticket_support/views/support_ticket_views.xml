<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="model_account_move_action_share" model="ir.actions.server">
            <field name="name">Stage Update</field>
            <field name="model_id" ref="ticket_support.model_support_ticket"/>
            <field name="binding_model_id" ref="ticket_support.model_support_ticket"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
             action = records.close()</field>
        </record>

    <!-- View support.ticket View List -->
    <record id="view_support_ticket_list" model="ir.ui.view">
        <field name="name">view.support.ticket.list</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="priority" widget="priority" />
                <field name="partner_id" />
                <field name="stage" />
            </list>
        </field>
    </record>

    <!-- View support.ticket form -->
    <record id="view_support_ticket_form" model="ir.ui.view">
        <field name="name">view.support.ticket.form</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <form string="Support Ticket">
             <header>
                <button string='Resolved' name="resolved_button" groups='ticket_support.ticket_sl_group' type="object" class="btn btn-success" invisible="stage != 'inprogress' "/>
                <button string='InProgress' name="inProgress_button" groups='ticket_support.ticket_sl_group' type="object" class="btn btn-warning" invisible="stage != 'new' "/>
                <button string='Close' name="close_button" groups='ticket_support.ticket_sl_group' type="object" class="btn btn-danger" invisible="stage != 'resolved' "/>
                <field name="stage"  widget='statusbar'/>
             </header>
             <sheet>    
              <div class="oe_button_box" name='button_box' position='inside'>
                <button class="oe_stat_button" icon="fa-money" name="nav_related_invoice"  type="object">
                 <i class="fa fa-receipt"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Invoice</span>
                        <!-- <field name="sh_ticket_count" class="o_stat_value"/> -->
                    </div>
                </button>
              </div> 
              <group>     
                 <group>
                     <field name="name" class="display-6 fw-bold text-black" nolabel="1" readonly="1"/>
                     <field name="task_title" />
                     <field name="priority" widget="priority" />
                     <field name="partner_id" />
                     <field name="task_description"/>
                  </group>
                  <group>
                    <field name="developer" />
                    <field name="support_leader"/>
                  </group>
               </group>  
            </sheet>
            <chatter></chatter>
            </form>
        </field>
    </record>

    <!-- kanban -->

    <record id="ticket_support_view_kanban" model="ir.ui.view">
        <field name="name">ticket_support.view.kanban</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage">
               <field name="name" />
               <field name="stage" />
               <field name="developer" />
               <field name="support_leader" />
               <field name="priority" />

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                           <div class="o_kanban_details">
                             <strong><t t-esc="record.name.value or ''"/></strong>
                              <div> <b>Stage : </b> <t t-esc="record.stage.value or ''"/></div>
                             <div><b>Developer : </b>💼 <t t-esc="record.developer.value or ''"/></div>
                             <div><b>SL : </b>💼 <t t-esc="record.support_leader.value or ''"/></div>
                             <div><b>Priority : </b> <t t-esc="record.priority.value or ''"/></div>
                           </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

     <record id="view_support_ticket_pivot" model="ir.ui.view">
        <field name="name">view.support.ticket.pivot</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Support Ticket Analysis">
                <field name="developer" type="row"/> 
                <!-- <field name="name" type="measure" string="Ticket Count"/>  Count Tickets -->
            </pivot>
        </field>
    </record>

     <record id="view_support_ticket_calendar" model="ir.ui.view">
        <field name="name">view.support.ticket.calendar</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <calendar string="Support Tickets" date_start="resolved_date">
                <field name="name"/>
                <field name="developer"/>
                <field name="stage"/>
            </calendar>
        </field>
    </record>


    <!-- View support.ticket search -->
    <record id="view_support_ticket_search" model="ir.ui.view">
        <field name="name">view.support.ticket.search</field>
        <field name="model">support.ticket</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action support.ticket -->
    <record id="action_support_ticket" model="ir.actions.act_window">
        <field name="name">Support Ticket</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">support.ticket</field>
        <field name="view_mode">list,form,kanban,pivot,calendar,activity</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Support Ticket.
            </p>
        </field>
    </record>

    <menuitem
        id="ticket_menu"
        name="Ticket"
        action = "action_support_ticket"/>

</odoo>
