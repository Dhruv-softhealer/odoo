<odoo>
    <record id="ir_cron_auto_close_tickets" model="ir.cron">
        <field name="name">Auto Close Tickets in Resolved State</field>
        <field name="model_id" ref="model_support_ticket"/>
        <field name="state">code</field>
        <field name="code">model.auto_close_resolved_tickets()</field>
         <field name="nextcall" eval="(DateTime.now() + timedelta(minut=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>