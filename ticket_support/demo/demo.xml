<odoo>
    <data>

       <record id="demo_user_1" model="res.users">
            <field name="name">John Doe</field>
            <field name="login">john.doe@example.com</field>
        </record>

        <record id="demo_user_2" model="res.users">
            <field name="name">Jane Smith</field>
            <field name="login">jane.smith@example.com</field>
        </record>

        <record id="demo_customer_1" model="res.partner">
            <field name="name">ACME Corporation</field>
        </record>

        <record id="demo_customer_2" model="res.partner">
            <field name="name">Tech Solutions Ltd.</field>
        </record>

