<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_sh_approval_dashboard_my_pending" model="ir.actions.act_window">
        <field name="name">My Pending Approvals</field>
        <field name="res_model">sh.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','pending'), '|', ('line_ids.approver_ids','in',[uid]), ('line_ids.alternative_user_id','=',uid)]</field>
        <field name="search_view_id" ref="view_sh_approval_request_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_sh_approval_dashboard_approved" model="ir.actions.act_window">
        <field name="name">Approved</field>
        <field name="res_model">sh.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','approved')]</field>
        <field name="search_view_id" ref="view_sh_approval_request_search"/>
        <field name="context">{'create': False}</field>
    </record>

    <record id="action_sh_approval_dashboard_refused" model="ir.actions.act_window">
        <field name="name">Refused</field>
        <field name="res_model">sh.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','=','refused')]</field>
        <field name="search_view_id" ref="view_sh_approval_request_search"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
