<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sh_dynamic_approval" model="ir.module.category">
        <field name="name">Dynamic Approval</field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_sh_dynamic_approval" model="res.groups.privilege">
        <field name="name">Dynamic Approval</field>
        <field name="sequence">35</field>
        <field name="category_id" ref="module_category_sh_dynamic_approval"/>
    </record>

    <record id="group_sh_dynamic_approval_approver" model="res.groups">
        <field name="name">Approver</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_sh_dynamic_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sh_dynamic_approval_manager_readonly" model="res.groups">
        <field name="name">Manager Read-Only</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_sh_dynamic_approval"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_sh_dynamic_approval_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">40</field>
        <field name="privilege_id" ref="res_groups_privilege_sh_dynamic_approval"/>
        <field name="implied_ids" eval="[(4, ref('group_sh_dynamic_approval_approver')), (4, ref('group_sh_dynamic_approval_manager_readonly'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_sh_approval_type_company" model="ir.rule">
        <field name="name">Approval Type multi-company</field>
        <field name="model_id" ref="model_sh_approval_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_sh_dynamic_approval_admin')])]"/>
    </record>

    <record id="rule_sh_approval_request_user_scope" model="ir.rule">
        <field name="name">Approval Request user scope</field>
        <field name="model_id" ref="model_sh_approval_request"/>
        <field name="domain_force">['|', '|', ('requester_id', '=', user.id), ('line_ids.approver_ids', 'in', [user.id]), ('line_ids.alternative_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_sh_approval_request_manager_department" model="ir.rule">
        <field name="name">Approval Request manager department</field>
        <field name="model_id" ref="model_sh_approval_request"/>
        <field name="domain_force">[('requester_id.employee_id.department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_sh_dynamic_approval_manager_readonly'))]"/>
    </record>

    <record id="rule_sh_approval_request_authorized_company" model="ir.rule">
        <field name="name">Approval Request authorized company</field>
        <field name="model_id" ref="model_sh_approval_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_sh_dynamic_approval_admin')])]"/>
    </record>

    <record id="rule_sh_approval_line_user_scope" model="ir.rule">
        <field name="name">Approval Line user scope</field>
        <field name="model_id" ref="model_sh_approval_line"/>
        <field name="domain_force">['|', '|', ('request_id.requester_id', '=', user.id), ('approver_ids', 'in', [user.id]), ('alternative_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_sh_approval_line_manager_department" model="ir.rule">
        <field name="name">Approval Line manager department</field>
        <field name="model_id" ref="model_sh_approval_line"/>
        <field name="domain_force">[('request_id.requester_id.employee_id.department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_sh_dynamic_approval_manager_readonly'))]"/>
    </record>

    <record id="rule_sh_approval_line_authorized_company" model="ir.rule">
        <field name="name">Approval Line authorized company</field>
        <field name="model_id" ref="model_sh_approval_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_sh_dynamic_approval_admin')])]"/>
    </record>

    <record id="rule_sh_approval_log_user_scope" model="ir.rule">
        <field name="name">Approval Log user scope</field>
        <field name="model_id" ref="model_sh_approval_log"/>
        <field name="domain_force">['|', '|', ('request_id.requester_id', '=', user.id), ('request_id.line_ids.approver_ids', 'in', [user.id]), ('request_id.line_ids.alternative_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_sh_approval_log_manager_department" model="ir.rule">
        <field name="name">Approval Log manager department</field>
        <field name="model_id" ref="model_sh_approval_log"/>
        <field name="domain_force">[('request_id.requester_id.employee_id.department_id', '=', user.employee_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_sh_dynamic_approval_manager_readonly'))]"/>
    </record>

    <record id="rule_sh_approval_type_company_global" model="ir.rule">
        <field name="name">Approval Type multi-company global</field>
        <field name="model_id" ref="model_sh_approval_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sh_approval_request_company_global" model="ir.rule">
        <field name="name">Approval Request multi-company global</field>
        <field name="model_id" ref="model_sh_approval_request"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sh_approval_line_company_global" model="ir.rule">
        <field name="name">Approval Line multi-company global</field>
        <field name="model_id" ref="model_sh_approval_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_sh_approval_log_company_global" model="ir.rule">
        <field name="name">Approval Log multi-company global</field>
        <field name="model_id" ref="model_sh_approval_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
